---
/**
 * The 403/404/502/503/50x pages: a full-screen noise canvas with the code and
 * a message over it. The page's own message goes in the default slot; the
 * contact/help paragraph below it is shared.
 *
 * Links are relative ("index.html") on purpose in the legacy pages too; the
 * web server serves these at whatever URL failed.
 */
import Base from './Base.astro';
import NoiseScreen from '../components/NoiseScreen.astro';

interface Props {
  code: string;
  title: string;
  description: string;
}
const { code, title, description } = Astro.props;
---
<Base title={title} description={description} footer={false}>
  <NoiseScreen code={code}>
    <slot />
      <small>
        Feel this was a mistake? Contact us at <a href="mailto:webmaster@roos.com">webmaster@roos.com</a> for
        assistance
        with this page, or
        contact our <a href="/support.html">experienced application engineers</a> for product and technical
        questions.<br>
        In the meantime, check out our <a href="/rik">RI Kit Portfolio</a> of accessories or browse <a
          href="/docs">technical documentation</a> for application notes, white papers, and more.
      </small>
  </NoiseScreen>
</Base>
