---
import Base from '../layouts/Base.astro';
---
<Base title={"Services Overview | Roos Instruments"}
  description={"Let Roos Instruments provide end-to-end solution to your test challenges. With over 25 years of wireless expertise and close familiarity with what the modular Cassini ATE platform can accomplish, no test challenge is too great."}
  active={["nav-services"]}>
      <!-- ==========================
    	BREADCRUMB - START
    =========================== -->
      <section class="breadcrumb-wrapper">
        <div class="container">
          <h2>Services</h2>
          <ol class="breadcrumb">
            <li><a href="/index.html">Home</a></li>
            <li class="active">Services</li>
          </ol>
        </div>
      </section>
      <!-- ==========================
    	BREADCRUMB - END
    =========================== -->

      <section id="content" class="roosC container">
        <h2>Turnkey Applications</h2>
        <img class="visible-xs-block" style="max-width: 300px;" alt="Turnkey" src="images/turnkey.jpg">
        <div class="row">
          <div class="col-sm-6">
            <p class="main">
              Let Roos Instruments provide end-to-end solution to your test challenges. With over 25 years of
              wireless expertise and close familiarity with what the modular Cassini ATE platform can
              accomplish, no
              test challenge is too great.
            </p>
            <a style="float: right;" href="turnkey.html" class="main link">Test With Confidence &raquo;</a>
          </div>
          <div class="hidden-xs col-sm-offset-1 col-sm-5">
            <img class="rightImgAlignH1-H3 hidden-xs" style="max-width: 300px;" alt="Turnkey" src="images/turnkey.jpg">
          </div>
        </div>
        <hr class="space">
        <div class="row">
          <div class="col-sm-4 col-sm-offset-1">
            <img class="offset-1 hidden-xs leftImgAlignH1-H3" style="max-width: 225px;" alt="Engineering Services"
              src="images/toolbox_icon.png">
          </div>
          <div class="col-sm-6 col-sm-offset-1">
            <h2>Engineering Services</h2>
            <img class="visible-xs-block leftImgAlignH1-H3" style="max-width: 225px;" alt="Engineering Services"
              src="images/toolbox_icon.png">
          </div>
          <div class="col-sm-6 col-sm-offset-1">
            <ul class="hidden-xs col-sm-8 col-md-7 text-right">
              <li>Test Development</li>
              <li>Device Interface</li>
              <li>Cassini Configuration</li>
              <li style="margin-left: -70px;">Production&nbsp;Workflow&nbsp;Management</li>
            </ul>
          </div>
          <div class="visible-xs-block">
            <ul>
              <li>Test Development</li>
              <li>Device Interface</li>
              <li>Cassini Configuration</li>
              <li>Production Workflow Management</li>
            </ul>
          </div>
          <div class="col-sm-6">
            <p class="main">
              Partner with engineers from Roos Instruments to quickly solve design and production test issues
              rapidly&nbsp;and&nbsp;effectivly.
            </p>
          </div>
        </div>
        <hr class="space">
        <h2>Fully Integrated Solutions</h2>
        <div class="row">
          <div class="col-sm-5 col-sm-push-7">
            <img style="max-width: 377px;" alt="Bench Correlation" src="images/all_things_equal-trimmed.png">
          </div>
          <div class="col-sm-7 col-sm-pull-5">
            <p class="main">
              Roos Instruments has everything needed for production test. You provide the DUT and the socket,
              we can do the rest.
            </p>
            <ul>
              <li>Handler/Prober Interface with Manipulator</li>
              <li>Device Interface with custom Testhead &amp; <abbr
                  title="Simple Device Interface Board: only 12mil 2-layer!">Simple DIB</abbr></li>
              <li>Customizable Operator UI &amp; Workflow (with barcode)</li>
              <li>Enterprise Workflow, Data Integration, &amp; Analytics.</li>
            </ul>
          </div>
        </div>

      </section> <!-- End of #content section-->
</Base>
