---
import Base from '../layouts/Base.astro';
---
<Base title={"Get the Cassini Reference Guide | Roos Instruments"}
  description={"Cassini Reference Guide provides development engineers and maintenance staff a comprehensive source for the test system’s various software and hardware components. Topics include safety practices, system references and instrument diagrams as well as general care, maintenance, diagnostic, calibration, and troubleshooting information.."}
  canonical={"https://roos.com/refGuide"}
  active={["nav-support"]}>
        <!-- ==========================
    	BREADCRUMB - START
    =========================== -->
        <section class="breadcrumb-wrapper">
            <div class="container">
                <h2>Cassini Reference Guide</h2>

                <ol class="breadcrumb">
                    <li><a href="/index.html">Home</a></li>
                    <li><a href="/support.html">Support</a></li>
                    <li class="active">Cassini Reference Guide</li>
                </ol>
            </div>
        </section>
        <!-- ==========================
    	BREADCRUMB - END
    =========================== -->

        <div id="content" class="roosC container">
            <div class="row">
                <div class="col-sm-4">
                    <p>
                        <!-- EDITOR NOTE: also edit /CassiniReferenceGuide_latest.pdf in Domino Config Web Redirect Rule -->
                        <a href="/pdf/CassiniReferenceGuide_2.8_mini.pdf" download="CassiniReferenceGuide_2.8_mini.pdf">
                            <img src="/images/CassiniReferenceGuide.png" alt="Cassini Reference Guide">
                        </a>
                    </p>
                </div>
                <div class="col-sm-8">
                    <hr class="space">
                    <h3>Cassini Reference Guide</h3>
                    <p>This reference guide provides development engineers and maintenance staff a comprehensive source
                        for the test system’s various software and hardware components. Topics include safety practices,
                        system references and instrument diagrams as well as general care, maintenance, diagnostic,
                        calibration, and troubleshooting information.
                    </p>
                    <p style="text-align: center;">
                        <a href="https://itunes.apple.com/us/book/cassini-reference-guide/id816739794?mt=11&uo=10">
                            <img src="/images/Apple_Books_Badge.svg"
                                alt="Apple Books version of Cassini Reference Guide"
                                style="max-width: 130px; margin: auto;">
                        </a>
                    </p>
                    <p style="text-align: center;">
                        <a class="btn btn-primary" href="/pdf/CassiniReferenceGuide_2.8_mini.pdf"
                            download="CassiniReferenceGuide_2.8_mini.pdf"><i class="far fa-file-pdf"></i> Download
                            PDF</a>
                    </p>
                </div>
            </div>
            <!-- end .row -->
            <hr class="space" />
            <div class="row">
                <div class="col-sm-1 col-sm-offset-3">
                    <img src="/images/Apple_Books-icon-250x250.jpg" alt="Apple Books App" width="250">
                </div>
                <div class="col-sm-8">
                    <p>To Update, from the Books app, tap on <span style="font-weight: bold">Reading Now > Account
                            (icon) > Updates</span> and <span style="font-weight: bold">Update All</span>.</p>
                    <p>For iOS 9, tap <span style="font-weight: bold">Purchased > Updates</span> from the iBooks app.
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-8 col-sm-offset-4">
                    <p>Join our self paced online learning course for test engineers at <a
                            href="https://learn.roos.com">learn.roos.com</a></p>
                </div>
            </div>
        </div>
</Base>
