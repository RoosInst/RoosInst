---
import Base from '../layouts/Base.astro';
---
<Base title={"6G Device Testing | Roos Instruments"}
  description={"Cassini is the only fully integrated ATE solution for high frequency markets up to 110 GHz\n                    GHz and is 6G ready today. 6G technology rapidly changes, the Cassini 16 slot ATE platform allows\n                    for flexibility by progressively adding higher frequency capability."}
  active={["nav-products"]}>
  <Fragment slot="head-early">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tiny-slider/2.9.4/tiny-slider.css">
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/tiny-slider/2.9.4/min/tiny-slider.js"
        integrity="sha384-bnNe8RYtqyFHZvs1dFmvpADgeNEGZCbzu5usprc4RtX/MlNbrGRu6aTZzVQHYiA1"
        crossorigin="anonymous"></script>
  </Fragment>
  <Fragment slot="head">
    <meta name="keywords"
        content="6G Device Testing, Cassini ATE, High Frequency Semiconductors, S-Parameter Testing, Massive MIMO, Beam Forming, 
        Signal Sourcing, Noise Sourcing, RF Testing, Telecom Device Testing, Roos Instruments, 6G Technology, Automated Test Equipment, High Port Count Devices, Frequency Translation">
  </Fragment>
