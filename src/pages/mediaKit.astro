---
import Base from '../layouts/Base.astro';
---
<Base title={"Media Kit | Roos Instruments"}
  description={"Roos Instruments Logo and Branding Guide for marketing purposes."}
  active={["nav-company","nav-company"]}>
    <!-- ==========================
    	BREADCRUMB - START
    =========================== -->
    <section class="breadcrumb-wrapper">
      <div class="container">
        <h2>Media Kit</h2>
        <ol class="breadcrumb">
          <li><a href="/index.html">Home</a></li>
          <li class="active">Media Kit</li>
        </ol>
      </div>
    </section>
    <!-- ==========================
    	BREADCRUMB - END
    =========================== -->

    <div id="content" class="roosC container mediaKit">
      <!-- ==========================
    	CONTENT - START  (this is comment line can be excluded from actual content)
    =========================== -->
      <!-- <h3>Company Colors</h3>
    <div class="row">
      <div class="col-xs-6 col-md-3">
         <div class="thumbnail">
           #000000
         </div>
      </div>
      <div class="col-xs-6 col-md-3">
