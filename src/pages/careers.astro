---
import Base from '../layouts/Base.astro';
---
<Base title={"Careers | Roos Instruments"}
  description={"Join Roos Instrument's Team!  We may not be hiring at the moment, please check back for job postings here when they become available.  \n    We are an equal opportunity employer and value diversity and are inclusvie to all backgrounds."}
  active={["nav-company"]}>
    <!-- ==========================
    	BREADCRUMB - START
    =========================== -->
    <section class="breadcrumb-wrapper">
      <div class="container">
        <h2>Careers</h2>
        <ol class="breadcrumb">
          <li><a href="/index.html">Home</a></li>
          <li><a href="/company.html">Company</a></li>
          <li class="active">Careers</li>
        </ol>
      </div>
    </section>
    <!-- ==========================
    	BREADCRUMB - END
    =========================== -->

    <section id="content" class="roosC container">
      <div class="row">
        <div class="col-md-12">
          <h2>Join Our Family</h2>
          <p class="main">
            Join the Roos Instruments' family and our quest to develop the fastest,
            most accurate <abbr title="Automated Test Equipment">ATE</abbr> for the worlds most advanced technology.
            <br>
            We are looking for the brightest and best minds, looking
            for a challenging carreer at the cutting edge of measurement
            technology.
            <br />
            Roos Instruments unique work environment includes competitive benifits and a family
            friendly atmosphere.
          </p>
          <div class="pull-right"><a href="mailto:admin@roos.com?Subject=Resume" class="btn btn-primary"><i
                class="far fa-edit"></i>Apply Via Email</a>
          </div>
        </div>
      </div>


      <div class="row">
        <div class="col-md-12">
          <script is:inline src="//platform.linkedin.com/in.js"></script>
          <script is:inline type="IN/CompanyProfile" data-id="147711" data-format="inline"></script>

          <script is:inline src="//platform.linkedin.com/in.js"></script>
          <script is:inline type="IN/CompanyInsider" data-id="147711"></script>

        </div>
      </div>
    </section> <!-- End of #content section-->
</Base>
