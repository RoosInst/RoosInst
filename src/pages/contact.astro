---
import Base from '../layouts/Base.astro';
---
<Base title={"Contact Us | Roos Instruments"}
  description={"Contact Roos Instruments for Support or Sales.  Reach out to any of our representatives in your home country or development partners."}
  active={["nav-company"]}>
    <!-- ==========================
    	BREADCRUMB - START
    =========================== -->
    <section class="breadcrumb-wrapper">
      <div class="container">
        <h2>Contact Us</h2>
        <ol class="breadcrumb">
          <li><a href="/index.html">Home</a></li>
          <li><a href="/company.html">Company</a></li>
          <li class="active">Contact Us</li>
        </ol>
      </div>
    </section>
    <!-- ==========================
    	BREADCRUMB - END
    =========================== -->

    <div id="content" class="roosC container text-center">
      <div style="margin-bottom: 30px;" class="row">
        <div class="col-md-6">
          <div>
            <div style="padding-top: 40px;">
              <a class="btn-primary btn-lg" href="mailto:sales@roos.com"><i
                  class="fa-solid fa-envelope"></i>&nbsp;&nbsp;Email Sales</a>
