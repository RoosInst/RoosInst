            <a href="/visitRI.html"><i class="fa-solid fa-calendar-alt"></i> Plan a Visit</a>
          </div>
          <a href="https://goo.gl/maps/4eQnc">
            <small><i class="fa-solid fa-map-marker-alt">&nbsp;&nbsp;</i>
              Roos Instruments, Inc.
              <span class="contactLinks adr"><span
                  class="street-address">2285 Martin Avenue</span><br>
                <span class="locality">Santa Clara</span>, <span class="region">California</span> <span
                  class="postal-code">95050</span><br><span class="country-name">United States</span></span><br>
            </small>
          </a>
          <p style="margin-top: 30px;">International Shipments:<br>ECCN: 3B992.b <br> HTC: 9030.82.00.00 RF Test Equipment Accessories</p>
