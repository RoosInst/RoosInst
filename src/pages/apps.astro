---
import Base from '../layouts/Base.astro';
---
<Base title={"Cassini Configurations | Roos Instruments"}
  description={"Cassini ATE can be used to test a wide variety of devices used many commpn applications."}
  active={["nav-products"]}>
  <Fragment slot="head">
    <meta name="keywords" content="Applications, Roos Instruments' Cassini ATE, High Frequency Semiconductors, Semiconductor ATE, Automated Test Equipment Applications">
  </Fragment>
    <!-- ==========================
    	BREADCRUMB - START
    =========================== -->
    <section class="breadcrumb-wrapper">
      <div class="container">
        <h2>Cassini Configurations</h2>
        <ol class="breadcrumb">
          <li><a href="/index.html">Home</a></li>
          <li><a href="/products.html">Products</a></li>
          <li><a href="/infrastructure.html">Test Systems</a></li>
        </ol>
      </div>
    </section>
    <!-- ==========================
    	BREADCRUMB - END
    =========================== -->

    <div id="content" class="roosC container">
      <div style="margin: 0;" class="text-center row">
        <div class="col-sm-4">
          <div class="noRadius service">
            <i class="fa-solid fa-space-shuttle"></i>
            <div class="service-body">
              <h5 class="upper">Future Technology</h5>
              <ul>
                <li><a href="/">60 GHz <abbr title="Personal Area Networks">PANs</abbr></a></li>
                <li><a href="/">Ultra Low Power Tx/Rx</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-sm-4">
          <div class="noRadius service">
            <i class="fa-solid fa-desktop"></i>
            <div class="service-body">
              <h5 class="upper">Current Devices</h5>
              <ul>
                <li><a href="/">Automotive Radar</a></li>
                <li><a href="/">LTE</a></li>
                <li><a href="/">Wifi (A,B,G,N)</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-sm-4">
          <div class="noRadius service">
            <i class="far fa-save"></i>
            <div class="service-body">
              <h6 class="upper">Legacy Equipment</h6>
              <ul>
                <li><a href="/parts/CASSINI-3G">3G - CDMA 2000, UMTS</a></li>
                <li><a href="/">RF Power Amplifiers</a></li>
                <li><a href="/">Cordless Phones</a></li>
                <li><a href="/">Satellite Transceivers</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
</Base>
